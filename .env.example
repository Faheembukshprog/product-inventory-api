# ====================================================
# Product Inventory API - Environment Variables
# ====================================================
# Copy this file to ".env" and fill in real values.
#   cp .env.example .env
# Never commit the .env file to GitHub.
# ====================================================

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# JSON Web Token
# Generate a strong random string (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ----- MongoDB connection (choose ONE) -----

# Option A: MongoDB Atlas (cloud) - recommended for submission
# Format: mongodb+srv://<username>:<password>@<cluster>/?dbname&options
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/product_inventory?retryWrites=true&w=majority

# Option B: Local MongoDB (no Atlas account needed)
# Uncomment the line below to use a local MongoDB instance instead
# MONGO_URI=mongodb://127.0.0.1:27017/product_inventory

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
